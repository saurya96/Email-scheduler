generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String   @id @default(cuid())
  googleSub     String?  @unique
  email         String
  name          String
  avatarUrl     String?
  slackWebhookEncrypted String?
  slackChannelId        String?
  slackChannelName      String?
  emailCredential EmailCredential?
  emails        Email[]
  emailBatches  EmailBatch[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model EmailBatch {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  idempotencyKey String   @unique
  attachments    Json
  emails         Email[]
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
}

model EmailCredential {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  tenantId     String   @unique
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

model Email {
  id             String      @id @default(cuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipient      String
  subject        String
  body           String      @db.Text
  bodyHtml       String?     @db.Text
  scheduledAt    DateTime
  sentAt         DateTime?
  status         EmailStatus @default(SCHEDULED)
  starred        Boolean     @default(false)
  senderId       String
  delayMs        Int
  hourlyLimit    Int
  idempotencyKey String      @unique
  batchId        String?
  batch          EmailBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  error          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([tenantId, status, scheduledAt])
  @@index([tenantId, sentAt])
  @@index([senderId, scheduledAt])
  @@index([batchId])
}

enum EmailStatus {
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}
