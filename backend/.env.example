NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:4000
DATABASE_URL=postgresql://scheduler:scheduler@localhost:5432/reachinbox?schema=public
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
SESSION_SECRET=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-character-key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CALLBACK_URL=http://localhost:4000/auth/slack/callback
SMTP_SENDERS=[{"id":"ethereal-one","email":"your-ethereal-address@example.com","host":"smtp.ethereal.email","port":587,"secure":false,"user":"your-ethereal-username","pass":"your-ethereal-password"}]
WORKER_CONCURRENCY=5
MIN_SEND_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
EMAIL_ATTACHMENT_STORAGE_DIR=./data/email-attachments
EMAIL_ATTACHMENT_MAX_FILE_SIZE_MB=10
EMAIL_ATTACHMENT_MAX_TOTAL_SIZE_MB=20
CORS_ORIGIN=http://localhost:5173
